# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# BASE DE DONNÉES
# ============================================
MONGO_URI=mongodb://localhost:27017/snrt_pgs

# ============================================
# JWT
# ============================================
JWT_SECRET=change_this_in_production_use_a_strong_secret_key
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=change_this_in_production_refresh_token

# ============================================
# EMAIL (2FA, notifications)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@snrt.ma

# ============================================
# SÉCURITÉ
# ============================================
TWO_FACTOR_EXPIRE=10m
MAX_LOGIN_ATTEMPTS=3
BLOCK_DURATION=60m

# ============================================
# FRONTEND (CORS)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/